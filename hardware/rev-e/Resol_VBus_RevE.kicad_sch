	(text "2  POLARITY-INDEPENDENT VBUS / RX WITH HYSTERESIS"
		(exclude_from_sim no)
		(at 12.7 93.98 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "27505f9e-6847-414f-80c5-6f1c8c38fc5f")
	)
	(text "Resistors: 1%, 0805. Bypass: 100n, 50V X7R.\nC1/C3/C13: 22u, 25V X7R, 1210.\nC5: 22u, 25V X7R, 1210."
		(exclude_from_sim no)
		(at 12.7 68.58 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "27906bfc-7cde-49d8-b350-145458f526aa")
	)
	(text "UART 9600 8N1, non-inverted.\nD1: RX13 / TX12. S3: RX11 / TX13.\nDisconnect external 5 V before USB.\nTX requires firmware bus arbitration."
		(exclude_from_sim no)
		(at 299.72 238.76 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left top)
		)
		(uuid "28161831-233a-461c-97fc-161aca17b649")
	)
	(text "3  TX WITH UNDERVOLTAGE INHIBIT"
		(exclude_from_sim no)
		(at 12.7 198.12 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "2b73bad7-3d6f-4a71-b0c9-373ae088535d")
	)
	(text "Nominal VBUS_RECT thresholds: about 2.01 / 2.26 V.\nC10 filters noise. U3 uses the ST TS391R pin assignment."
		(exclude_from_sim no)
		(at 12.7 177.8 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "35cef1dc-37fd-4d10-9e63-817f09103e8d")
	)
	(text "MCU DOMAIN / GND"
		(exclude_from_sim no)
		(at 307.34 17.78 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "73fbd6cf-0665-408b-bdaf-e0de468391ae")
	)
	(text "VBUS DOMAIN / GND_ISO"
		(exclude_from_sim no)
		(at 12.7 27.94 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "7a9cce4e-7775-4251-9f67-bdf8eb9252ba")
	)
	(text "1  ISOLATED POWER FROM EXTERNAL 5 V"
		(exclude_from_sim no)
		(at 12.7 17.78 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "840146e8-695a-4f8e-8e95-a09585437800")
	)
	(text "U4: ISO7221ADR, both sides at 3.3 V.\nDo not fit a default-LOW isolator."
		(exclude_from_sim no)
		(at 297.18 182.88 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "ba304385-5dde-484e-bc34-8159858ca98e")
	)
	(text "U6: Y = READY AND NOT TX.\nTX HIGH: bus released. TX LOW: Q1 on.\nU5: 3.08 V threshold; release delay 140..560 ms."
		(exclude_from_sim no)
		(at 12.7 266.7 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "de7ec726-02f3-4875-8e01-552d9efb0a0c")
	)
	(text "VBus powers only the RX divider.\nU1 powers the isolated RX/TX interface,\nindependently of bus levels and pauses.\nR1: rail discharge and reference load.\nDo not connect GND to GND_ISO."
		(exclude_from_sim no)
		(at 12.7 43.18 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "e44a54c0-2261-45ff-b361-8259d4b9caa3")
	)
